views:
  - type: table
    name: Meals
    filters:
      and:
        - type == "meal"
        - '!file.path.contains("99 Archive")'
    order:
      - file.name
      - recipes
      - duration_mins
    sort:
      - property: date
        direction: DESC
      - property: file.name
        direction: DESC
  - type: table
    name: Recipe
    filters:
      and:
        - type == "recipe"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - staple
      - retired
      - tried
      - to-try
