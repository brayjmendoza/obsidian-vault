views:
  - type: table
    name: Plans
    filters:
      and:
        - type == "plan"
    order:
      - file.name
      - review_by
      - updated
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: All Plans
    filters:
      and:
        - type == "plan"
        - '!file.path.contains("Private")'
        - '!file.path.contains("99 Archive")'
