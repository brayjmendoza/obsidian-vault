views:
  - type: table
    name: Unmapped Concepts
    filters:
      and:
        - type == "concept"
        - fields.contains(this.field)
        - "!this.file.hasLink(file)"
    order:
      - file.name
      - fields
      - confidence
      - last_reviewed
    sort:
      - property: file.name
        direction: ASC
