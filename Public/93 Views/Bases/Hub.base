views:
  - type: table
    name: Current
    filters:
      and:
        - file.inFolder(this.file.folder)
        - or:
            - status == "learning"
            - status == "polishing"
            - status == "relearning"
            - status == "planning"
            - status == "booked"
    order:
      - file.name
      - type
      - status
      - last_practiced
      - start
    sort:
      - property: start
        direction: DESC
      - property: type
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Projects
    filters:
      and:
        - type == "project"
        - file.hasLink(this.file)
        - status != "done"
        - status != "dropped"
    order:
      - file.name
      - status
      - due
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Recent
    filters:
      and:
        - file.inFolder(this.file.folder)
        - or:
            - type == "practice"
            - type == "session"
            - type == "spending"
            - type == "log"
            - type == "meal"
    order:
      - file.name
      - type
      - note.date
      - note.duration_mins
      - note.focus
    sort:
      - property: note.date
        direction: DESC
      - property: file.name
        direction: DESC
    limit: 7
