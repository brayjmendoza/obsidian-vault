views:
  - type: table
    name: Pieces
    filters:
      and:
        - type == "piece"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - repertoire
      - learning
      - retired
      - wishlist
  - type: table
    name: Bach
    filters:
      and:
        - type == "piece"
        - composers.contains(link("Johann Sebastian Bach"))
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - repertoire
      - learning
      - retired
      - wishlist
