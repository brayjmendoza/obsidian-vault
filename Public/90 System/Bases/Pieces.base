views:
  - type: table
    name: Pieces
    filters:
      and:
        - type == "piece"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - repertoire
      - learning
      - retired
      - wishlist
  - type: table
    name: Liszt
    filters:
      and:
        - type == "piece"
        - composers.contains(link("Franz Liszt"))
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - repertoire
      - learning
      - retired
      - wishlist
  - type: table
    name: Chopin
    filters:
      and:
        - type == "piece"
        - composers.contains(link("Frédéric Chopin"))
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - repertoire
      - retired
      - wishlist
  - type: table
    name: Löschhorn
    filters:
      and:
        - type == "piece"
        - composers.contains(link("Carl Albert Löschhorn"))
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - retired
