# direnv: keep the virtual environment out of iCloud, which would sync thousands of machine-specific files.
# Run `direnv allow` once after cloning or editing this file.
export UV_PROJECT_ENVIRONMENT="$HOME/.venvs/vault-tools"

# auto-activate and deactivate the environment when entering and leaving this folder
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
PATH_add "$VIRTUAL_ENV/bin"